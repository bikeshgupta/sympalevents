## Browser/public config. In Vercel, add these as Config values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

## Server-only secrets/config. In Vercel, add these as Secret values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_PROJECT_ID=

## The owner-only Platform Control Center (/platform/analytics). Comma-separated app_users ids.
## Empty means nobody can open it. In Vercel, add it as a Secret value.
PLATFORM_ADMIN_USER_IDS=

## Optional: connect Vercel to the Control Center's System page (read-only deployment list). Server-only secrets.
## Leave empty and System says "Not connected". The token needs read access to deployments for this project only.
PLATFORM_VERCEL_TOKEN=
PLATFORM_VERCEL_PROJECT_ID=
PLATFORM_VERCEL_TEAM_ID=
