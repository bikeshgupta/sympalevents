## Browser/public config. In Vercel, add these as Config values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

## Self-service UPI contributions. Leave VITE_UPI_ID blank to hide the
## "Contribute now" button everywhere - there is nothing to pay to without it.
## This is the committee's own UPI id (the same string on a payment QR code),
## not a merchant/gateway credential, which is why it is a public value.
VITE_UPI_ID=
## Optional. The name UPI apps show as the payee; defaults to the VPA's handle.
VITE_UPI_PAYEE_NAME=

## Server-only secrets/config. In Vercel, add these as Secret values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_PROJECT_ID=
